{
  "name": "metasave",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev-fe\" \"npm run dev-be\" \"npm run run-camera\" \"npm run run-odroid\"",
    "dev-fe": "npm --prefix packages/metasave-fe run dev",
    "dev-be": "npm --prefix packages/metasave-be run dev",
    "dev-camera": "python packages/model/camera_nuc.py",
    "dev-apitest": "python packages/model/test/apitest.py",
    "dev-odroid": "python packages/model/odroid.py",
    "dev-listen-ble": "python packages/model/listenDeviceBLE.py",
    "dev-listen-wired": "python packages/model/listenDeviceWired.py",
    "dev-listen": "python packages/model/listenDevice.py",
    "compile-contract": "",
    "deploy-contract": ""
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "requests": "^0.3.0",
    "@tanstack/react-query": "^5.83.0",
    "@web3auth/modal": "^10.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wagmi": "^2.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
